{
  "name": "@putervision/vision-memory-mcp",
  "version": "0.3.0",
  "description": "An MCP server that caches visual UI states using perceptual hashing, vector search, and graph transitions to optimize agent context and reduce tokens.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "vision",
    "cache",
    "perceptual-hash",
    "vector-search",
    "lancedb",
    "clip"
  ],
  "homepage": "https://putervision.github.io/vision-memory-mcp",
  "bugs": {
    "url": "https://github.com/putervision/vision-memory-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/putervision/vision-memory-mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "PuterVision LLC",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vision-memory-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "cli": "node dist/cli.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@lancedb/lancedb": "^0.13.0",
    "@modelcontextprotocol/sdk": "^1.0.1",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "prettier": "^3.9.6",
    "tsup": "^8.1.0",
    "typescript": "^5.5.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
