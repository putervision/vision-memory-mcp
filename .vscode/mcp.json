{
  "servers": {
    "state-memory-mcp": {
      "command": "state-memory-mcp",
      "args": [
        "run"
      ],
      "env": {
        "STATE_MEMORY_MCP_PROJECT": "vision-memory-mcp"
      }
    },
    "vision-memory-mcp": {
      "command": "vision-memory-mcp",
      "args": [
        "run"
      ],
      "env": {
        "LANCEDB_PATH": "./.vision-memory"
      }
    },
    "world-model-mcp": {
      "type": "stdio",
      "command": "world-model-mcp",
      "args": [
        "run"
      ],
      "env": {
        "WORLD_MODEL_MCP_PROJECT": "vision-memory-mcp"
      }
    },
    "agent-reasoning-mcp": {
      "type": "stdio",
      "command": "agent-reasoning-mcp",
      "args": [
        "run"
      ],
      "env": {
        "REASONING_PROJECT": "vision-memory-mcp"
      }
    },
    "behavior-mcp": {
      "type": "stdio",
      "command": "behavior-mcp",
      "args": [
        "run"
      ],
      "env": {
        "BEHAVIOR_PROJECT": "vision-memory-mcp"
      }
    }
  },
  "mcpServers": {
    "webcrypt": {
      "command": "npx",
      "args": [
        "-y",
        "webcrypt",
        "mcp"
      ]
    }
  }
}
