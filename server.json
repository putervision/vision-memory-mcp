{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.putervision/vision-memory-mcp",
  "version": "0.7.1",
  "title": "Visual Memory MCP",
  "description": "Local visual UI cache for AI agents using perceptual hashing + CLIP to cut vision token use.",
  "publisher": "PuterVision LLC",
  "license": "MIT",
  "websiteUrl": "https://visionmemorymcp.com",
  "icons": [
    {
      "src": "https://putervision.github.io/vision-memory-mcp/vision-memory-icon.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/putervision/vision-memory-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@putervision/vision-memory-mcp",
      "version": "0.7.1",
      "transport": {
        "type": "stdio"
      },
      "executable": "vision-memory-mcp",
      "args": [
        "run"
      ]
    }
  ]
}